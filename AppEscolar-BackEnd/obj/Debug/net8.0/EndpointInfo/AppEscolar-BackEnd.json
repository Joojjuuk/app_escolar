  "components": {
    "schemas": {
      "AdmCreateDTO": {
        "required": [
          "cargo",
          "email",
          "nome",
          "senha"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "senha": {
            "minLength": 1,
            "type": "string"
          },
          "nome": {
            "minLength": 1,
            "type": "string"
          },
          "cargo": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "AlunoCreateDTO": {
        "required": [
          "email",
          "nome",
          "ra",
          "senha"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "senha": {
            "minLength": 1,
            "type": "string",
            "format": "password"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "ra": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateNoticiaDTO": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string",
            "nullable": true
          },
          "descricao": {
            "type": "string",
            "nullable": true
          },
          "imagemUrl": {
            "type": "string",
            "nullable": true
          },
          "dataPublicacao": {
            "type": "string",
            "format": "date-time"
          },
          "tipoNoticia": {
            "$ref": "#/components/schemas/ETipoNoticia"
          }
        },
        "additionalProperties": false
      },
      "ETipoNoticia": {
        "enum": [
          1,
          2,
          3
        ],
        "type": "integer",
        "format": "int32"
      },
      "LoginDTO": {
        "required": [
          "email",
          "senha"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "senha": {
            "minLength": 1,
            "type": "string",
            "format": "password"
          }
        },
        "additionalProperties": false
      },
      "UpdateNoticiaDTO": {
        "type": "object",
        "properties": {
          "titulo": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "descricao": {
            "type": "string",
            "nullable": true
          },
          "imagemUrl": {
            "type": "string",
            "nullable": true
          },
          "tipoNoticia": {
            "$ref": "#/components/schemas/ETipoNoticia"
          }
        },
        "additionalProperties": false
      },
      "UserCreateDTO": {
        "required": [
          "email",
          "nome",
          "senha"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "senha": {
            "minLength": 6,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ViewQrCodeDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "qrCode": {
            "type": "string",
            "nullable": true
          },
          "pontos": {
            "type": "number",
            "format": "double"
          },
          "foiUsado": {
            "type": "boolean"
          },
          "dataGeracao": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
